{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splashy",
  "version": "1.0.7",
  "identifier": "com.halfaxas.splashy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Splashy",
        "width": 800,
        "height": 600,
        "minWidth": 620,
        "minHeight": 440,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGN0NBODA2ODY5NTZCQjUKUldTMWE1V0dCcWg4ejR0NzV6NU1nTHl3NEFwRXlMNUhUL2hmc1F6WUllUnp6dHdLV3UyS0loS2oK",
      "endpoints": [
        "https://github.com/Halfaxas/Splashy/releases/latest/download/latest.json"
      ]
    }
  }
}
